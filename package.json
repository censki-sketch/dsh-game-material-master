{
  "name": "dsh-game-material-master",
  "version": "0.12.0-motion.1",
  "description": "DSH 游戏素材大师白模流程社区版：八方向、4秒480P、默认2种动作（最多3种，实验性），支持本地准备白模、模板或文字模型整理提示词、视频分段抽帧、可选高清重绘与分动作导出。保留原项目的图片、序列帧、地图、音乐、音效和骨骼动画模块。",
  "type": "module",
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/censki-sketch/dsh-game-material-master.git"
  },
  "homepage": "https://github.com/censki-sketch/dsh-game-material-master#readme",
  "bugs": {
    "url": "https://github.com/censki-sketch/dsh-game-material-master/issues"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-gateway"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "files": [
    ".codex-plugin",
    ".mcp.json",
    "gpt-plugin",
    "assets/motion-templates",
    "docs/MOTION_WORKFLOW.md",
    "lib",
    "README.md",
    "README.en.md",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/strip-client-export.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:gpt": "node scripts/verify-gpt-bridge.mjs && node scripts/verify-gpt-workflow.mjs && node scripts/verify-gpt-mcp.mjs",
    "verify:rig:runtime": "node scripts/verify-rig-runtime.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-typert-protocol": "^0.2.1-rc.2",
    "@esotericsoftware/spine-core": "4.2.120",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "game-assets",
    "sprite-sheet",
    "chroma-key",
    "seedream",
    "minimax",
    "tilemap-editor",
    "tileset",
    "autotile",
    "wraparound",
    "music-generation",
    "ai-music",
    "scoremill",
    "midi-composition",
    "audio-editing",
    "puyue",
    "suno",
    "sound-effects",
    "sfx",
    "seed-audio",
    "volcengine",
    "isometric",
    "45-degree",
    "map-editor"
  ]
}
